#include <stdio.h>

int main() {
    // Declaracion de variables
    long long identificacion;
    int edad, hijos, estrato;
    float ingresos[12];
    float porcentaje_subsidio = 0.0;

    // Saludo e ingreso de datos personales
    printf("--- BIENVENIDO AL SISTEMA DE SUBSIDIOS ---\n");
    printf("Ingrese numero de identificacion: ");
    scanf("%lld", &identificacion);
    printf("Ingrese su edad: ");
    scanf("%d", &edad);
    printf("Ingrese numero de hijos: ");
    scanf("%d", &hijos);
    printf("Ingrese su estrato socioeconomico: ");
    scanf("%d", &estrato);

    // Lectura de los 12 meses de ingresos mediante ciclo FOR
    printf("\n--- INGRESO DE DATOS FINANCIEROS ---\n");
    for (int i = 0; i < 12; i++) {
        printf("Ingrese los ingresos del mes %d: ", i + 1);
        scanf("%f", &ingresos[i]);
    }

    // Evaluacion de condiciones y salida de datos
    printf("\n--- RESULTADOS DEL SUBSIDIO ---\n");
    if (estrato < 5) {
        // Calculo del porcentaje aplicable
        if (edad > 60) {
            porcentaje_subsidio += 0.08f;
        }
        porcentaje_subsidio += (hijos * 0.02f);

        // Muestra de subsidio mes a mes
        for (int i = 0; i < 12; i++) {
            float subsidio_mes = ingresos[i] * porcentaje_subsidio;
            printf("Mes %d: Subsidio asignado = $%.2f\n", i + 1, subsidio_mes);
        }
    } else {
        printf("El usuario no es apto para recibir subsidio (Estrato mayor o igual a 5).\n");
    }

    return 0;
}
